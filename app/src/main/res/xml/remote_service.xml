<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes only (to name the app in front); window content is read only to find the focused text box when the
     page types. The input method flag lets the page type as a keyboard into apps with no text box (Netflix). No key
     filtering, no gestures. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagInputMethodEditor"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:notificationTimeout="100" />
